  - m_Id: 118785826895
    m_Localized: Good night, Pofu!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826896
    m_Localized: Great!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826897
    m_Localized: Very nice!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826898
    m_Localized: Super!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826899
    m_Localized: "Can you find\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 118785826900
    m_Localized: Where is it?
    m_Metadata:
      m_Items: []
  - m_Id: 118785826901
    m_Localized: Pofu
    m_Metadata:
      m_Items: []
  - m_Id: 118785826902
    m_Localized: Hi, I'm Pofu!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826903
    m_Localized: Welcome back!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826904
    m_Localized: Let's go!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826905
    m_Localized: Pofu is so happy!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826906
    m_Localized: Hee hee, that tickles!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826907
    m_Localized: Wow!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826908
    m_Localized: Look at me, I look amazing!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826909
    m_Localized: I'm squeaky clean!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826910
    m_Localized: Smile!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826911
    m_Localized: Surpriiise!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826912
    m_Localized: Thank you!
    m_Metadata:
      m_Items: []
  - m_Id: 118785826913
    m_Localized: "Pofu is getting sleepy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 118785826914
    m_Localized: See you tomorrow!
    m_Metadata:
      m_Items: []
